<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2「下一节课倒计时」小组件：严格只使用 RemoteViews 允许的框架视图，无普通 <View>。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/wc_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/w_card" />

    <LinearLayout
        android:id="@+id/wc_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/wc_badge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="NEXT · 下一节"
            android:textColor="@color/w_accent"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Chronometer
                android:id="@+id/wc_chrono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/w_ink"
                android:textSize="28sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/wc_readout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="--:--"
                android:textColor="@color/w_ink"
                android:textSize="28sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ProgressBar
            android:id="@+id/wc_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginBottom="6dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/w_gauge_progress"
            android:visibility="gone" />

        <TextView
            android:id="@+id/wc_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="驴驴课表"
            android:textColor="@color/w_ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wc_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="点击查看今日课程"
            android:textColor="@color/w_sub"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
