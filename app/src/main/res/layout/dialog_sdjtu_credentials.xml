<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:importantForAutofill="noExcludeDescendants">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="账号密码仅在本机加密保存。同步课表时会先使用已有的登录状态，过期后再用保存的账号登录。学校要求验证码或刷脸时，请在门户页面完成验证。"
        android:textColor="?attr/gSub"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/sdjtu_login_username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="48dp"
        android:background="@drawable/bg_gauge_input"
        android:hint="统一门户账号"
        android:inputType="textNoSuggestions"
        android:paddingVertical="10dp"
        android:singleLine="true"
        android:textColor="?attr/gInk"
        android:textColorHint="?attr/gMute"
        android:textSize="15sp"
        android:imeOptions="actionNext|flagNoPersonalizedLearning"
        android:saveEnabled="false" />

    <EditText
        android:id="@+id/sdjtu_login_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:background="@drawable/bg_gauge_input"
        android:hint="统一门户密码"
        android:inputType="textPassword"
        android:paddingVertical="10dp"
        android:singleLine="true"
        android:textColor="?attr/gInk"
        android:textColorHint="?attr/gMute"
        android:textSize="15sp"
        android:imeOptions="actionDone|flagNoPersonalizedLearning"
        android:saveEnabled="false" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="首次启用或更换账号会退出本应用内已有的网页登录。"
        android:textColor="?attr/gSub"
        android:textSize="13sp" />
</LinearLayout>
