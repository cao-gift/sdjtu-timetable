<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 成绩检查和组件刷新都使用普通 Worker，移除依赖清单中的前台服务权限。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 课前提醒与小组件准点刷新：使用 SCHEDULE_EXACT_ALARM，未授权时在 Wake 中自动降级为非精确唤醒。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 「让小组件自己翻页」：弹系统窗口请求不受电池优化限制 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- 发邮件反馈（带诊断日志附件）前先看有没有邮件应用 -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="message/rfc822" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EcutCampus"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTop" />

        <!-- 沿用旧版本的三个桌面组件名，以便更新后已启用的图标及长按快捷方式继续可用。 -->
        <activity-alias
            android:name=".LauncherPear"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".LauncherArt"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".LauncherBenben"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- 添加桌面组件的小卡片（半透明）：前台请桌面放置，等回调；没弹窗就给权限入口和手动步骤。由快捷方式（桌面启动）打开，所以 exported -->
        <activity
            android:name=".PinWidgetActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.Tangli.PinCard" />

        <activity
            android:name=".WebShellActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTop" />


        <activity
            android:name=".SdjtuExamActivity"
            android:exported="false"
            android:label="考试安排"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".SdjtuStudyActivity"
            android:exported="false"
            android:label="山东交通学院教务"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".GradesActivity"
            android:exported="false"
            android:label="学业成绩"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ScheduleSettingsActivity"
            android:exported="false"
            android:label="上课时间"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".TimetableSettingsActivity"
            android:exported="false"
            android:label="课表设置"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".CourseEditActivity"
            android:exported="false"
            android:label="课程"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".CourseTodoActivity"
            android:exported="false"
            android:label="作业与待办"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />


        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:screenOrientation="portrait" />



        <activity
            android:name=".fun.FunActivity"
            android:exported="false"
            android:label="小工具"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".fun.GpaSimulatorActivity"
            android:exported="false"
            android:label="GPA 目标模拟器"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ClassmatesActivity"
            android:exported="false"
            android:label="同学"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ShareActivity"
            android:exported="false"
            android:label="分享课表"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".FreeTimeActivity"
            android:exported="false"
            android:label="共同空闲"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 旧版换图标被中断时，覆盖升级后将桌面入口恢复为一个。 -->
        <receiver
            android:name=".LauncherUpgradeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".ClassWidget"
            android:exported="false"
            android:label="今日课程">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_classes_info" />
        </receiver>

        <receiver
            android:name=".CountdownWidget"
            android:exported="false"
            android:label="下一节课倒计时">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_countdown_info" />
        </receiver>

        <receiver
            android:name=".DayProgressWidget"
            android:exported="false"
            android:label="今日进度条">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_day_progress_info" />
        </receiver>

        <!-- 考前提醒（考前一天与考前一小时） -->
        <receiver
            android:name=".ExamReminder$Receiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 作业截止提醒（前一天晚 20:00 与当天早 08:30） -->
        <receiver
            android:name=".TodoReminder$Receiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 下拉快捷设置磁贴：下一节课 & 今日空教室 & 同步课表 -->
        <service
            android:name=".NextClassTileService"
            android:exported="true"
            android:icon="@drawable/ic_nav_timetable"
            android:label="下一节课"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".FreeRoomTileService"
            android:exported="true"
            android:icon="@drawable/ic_nav_timetable"
            android:label="今日空教室"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".SyncTimetableTileService"
            android:exported="true"
            android:icon="@drawable/ic_refresh"
            android:label="同步课表"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 小组件「今日课程」里的课程列表（只有系统桌面能绑定） -->
        <service
            android:name=".ClassWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- 课前提醒：自己排的闹钟 + 开机/改时间/升级后重排（默认关，关着时只是空跑一下） -->
        <receiver
            android:name=".ClassReminder$Receiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 通知栏常驻「下一节课」（默认关）：上下课时刻的闹钟 + 开机/改时间/升级后重排 -->
        <receiver
            android:name=".NextClassNotice$Receiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
