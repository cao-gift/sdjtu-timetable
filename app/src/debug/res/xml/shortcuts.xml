<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_widget"
        android:shortcutId="open_today"
        android:shortcutLongLabel="@string/shortcut_today"
        android:shortcutShortLabel="@string/shortcut_today">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.ecut.campus.MainActivity"
            android:targetPackage="app.lvlv.timetable.debug">
            <extra android:name="tangli_action" android:value="open" />
            <extra android:name="tangli_value" android:value="today" />
        </intent>
    </shortcut>

